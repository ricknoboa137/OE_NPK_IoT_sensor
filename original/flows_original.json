    {
        "id": "06fee8be07ade0d1",
        "type": "function",
        "z": "55ef81d4c950013b",
        "name": "function 1",
        "func": "\nlet d= new Date();\nlet NEW_FORMAT = \"yyyy-MM-dd HH:mm:ss\";\nlet timestamp = d.getTime();\n\nlet timeStamp = d.getFullYear+\"-\"+d.getMonth+\"-\"+d.getDay+\" \"+d.getHours+\":\"+d.getMinutes+\":\"+d.getSeconds; \nlet humidity = msg.payload.Humidity;\nlet temperature = msg.payload.Temperature;\nlet ph = msg.payload.PH;\nlet N = msg.payload.Nitrogen;\nlet P = msg.payload.Phosphorus;\nlet K = msg.payload.Potassium;\nconst sensorData = msg.payload;\n\nconst params = {\n    timestamp: new Date().toISOString(),\n    temperature: sensorData.Temperature,\n    humidity: sensorData.Humidity,\n    ph: sensorData.PH,\n    N: sensorData.Nitrogen,\n    P: sensorData.Phosphorus,\n    K: sensorData.Potassium,\n};\nconst sql = \"INSERT INTO NPKv1 (humidity, temperature, ph, N, P, K, timestamp) VALUES (\"+humidity+\",\"+ temperature+\",\" + ph+\", \"+N+\", \"+P+\", \"+K+\", \"+timestamp+\");\";\nmsg.topic = sql;\nmsg.params = params;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
