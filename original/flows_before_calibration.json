    {
        "id": "444577de7c3d52e3",
        "type": "function",
        "z": "55ef81d4c950013b",
        "name": "ToPlotData temperature",
        "func": "const rows = Array.isArray(msg.payload) ? msg.payload : [];\n\nconst out = [{\n    series: [\"Temperature\"],\n    data: [[]],\n    labels: [\"\"]\n}];\n\nfor (const item of rows) {\n    if (item.temperature === null || item.temperature === undefined) { continue; }\n    out[0].data[0].push({\n        x: item.timestamp * 1000,   // stored as unix seconds, chart wants ms\n        y: item.temperature\n    });\n}\n\nmsg.payload = out;\nreturn msg;\n",
