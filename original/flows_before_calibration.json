        "func": "const rows = Array.isArray(msg.payload) ? msg.payload : [];\n\nconst out = [{\n    series: [\"Moisture\"],\n    data: [[]],\n    labels: [\"\"]\n}];\n\nfor (const item of rows) {\n    if (item.humidity === null || item.humidity === undefined) { continue; }\n    out[0].data[0].push({\n        x: item.timestamp * 1000,   // stored as unix seconds, chart wants ms\n        y: item.humidity\n    });\n}\n\nmsg.payload = out;\nreturn msg;\n",
